# apps/web (the Vite portal) build-time env. Copy to .env and fill in as needed.
# Every var is OPTIONAL — the app runs with none of them set. Each feature stays
# OFF until its vars are present (the Sentry / push "no-op unless configured" stance).

# Absolute backend API base for the NATIVE (Capacitor) build only. The browser build
# uses same-origin '/api' and ignores this. e.g. https://test-api.example.com/api
VITE_API_BASE_URL=

# Error reporting (optional). No DSN → Sentry initializes nothing, no network calls.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Firebase Cloud Messaging: WEB push (browser / installed PWA) ──
# These are your Firebase project's PUBLIC web config (not secrets). Use a TEST
# project — no production plan yet. All five + the VAPID key are required to turn
# web push on; leave any blank and getWebPushToken() no-ops.
# Also mirror these values into public/firebase-messaging-sw.js (that worker cannot
# read this file). Native (Android/iOS) push does NOT use these — it uses
# android/app/google-services.json instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# Google Maps JavaScript API key for the live order-tracking map. Optional: with no
# key the map is simply not shown and the pipeline stepper remains. Get one from
# Google Cloud Console → APIs & Services (enable "Maps JavaScript API"; add
# "Geocoding API" if you also set the backend GOOGLE_GEOCODING_API_KEY for the
# address-to-coordinates fallback). Restrict the key to your domains before shipping.
VITE_GOOGLE_MAPS_API_KEY=
