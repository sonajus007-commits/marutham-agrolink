# Release signing config for the Android app. Copy this file to
# `keystore.properties` (git-ignored) and fill in your values, then place the
# keystore .jks alongside it. NEVER commit the real file or the .jks.
#
# Create a keystore once (keep it safe — losing it means you can't update the app):
#   keytool -genkey -v -keystore marutham-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias marutham
#
# storeFile is resolved relative to the android/ project directory.
storeFile=marutham-release.jks
storePassword=CHANGE_ME
keyAlias=marutham
keyPassword=CHANGE_ME
