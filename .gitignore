# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Node
node_modules/

# Build artifacts — produced by the build, never committed.
# (A trailing "# comment" here would be read as part of the pattern, so these
#  stay on their own lines.)
# React SPA, served by Express at /app:
apps/web/dist/
# Next.js marketplace, served by Express at /:
apps/shop/.next/
# Serwist service worker — generated from apps/shop/app/sw.ts at build time:
apps/shop/public/sw.js
apps/shop/public/sw.js.map
apps/shop/public/swe-worker-*.js
.turbo/
*.tsbuildinfo
# Storybook static build:
apps/web/storybook-static/
# Playwright e2e output:
apps/web/playwright-report/
apps/web/test-results/
apps/web/.playwright/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code — local, per-machine settings and worktrees
.claude/
