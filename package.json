{
  "name": "marutham-agrolink",
  "version": "1.0.0",
  "private": true,
  "description": "Marutham AgroLink monorepo — legacy backend/frontend + new React app",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "corepack pnpm --filter @marutham/web dev",
    "build": "corepack pnpm --filter @marutham/web build",
    "preview": "corepack pnpm --filter @marutham/web preview",
    "typecheck": "corepack pnpm --filter @marutham/web --filter @marutham/shop run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm --filter @marutham/lib test",
    "test:backend": "npm --prefix backend test",
    "tokens:build": "corepack pnpm --filter @marutham/tokens tokens:build",
    "tokens:check": "corepack pnpm --filter @marutham/tokens tokens:check",
    "tokens:contrast": "corepack pnpm --filter @marutham/tokens tokens:contrast",
    "tokens:literals": "corepack pnpm --filter @marutham/tokens tokens:literals",
    "tokens:audit": "corepack pnpm --filter @marutham/tokens tokens:audit",
    "ui:classes": "corepack pnpm --filter @marutham/ui check:classes",
    "build:shop": "corepack pnpm --filter @marutham/shop build",
    "dev:shop": "corepack pnpm --filter @marutham/shop dev",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,mjs,cjs,json,css,scss,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  }
}
