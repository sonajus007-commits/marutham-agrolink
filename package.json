{
  "name": "marutham-agrolink",
  "version": "1.0.0",
  "private": true,
  "description": "Marutham AgroLink monorepo \u2014 legacy backend/frontend + new React app",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @marutham/web dev",
    "build": "pnpm --filter @marutham/web build",
    "preview": "pnpm --filter @marutham/web preview",
    "typecheck": "pnpm --filter @marutham/web typecheck",
    "test": "pnpm --filter @marutham/lib test",
    "test:backend": "npm --prefix backend test",
    "tokens:build": "pnpm --filter @marutham/tokens tokens:build",
    "tokens:check": "pnpm --filter @marutham/tokens tokens:check",
    "tokens:contrast": "pnpm --filter @marutham/tokens tokens:contrast",
    "tokens:literals": "pnpm --filter @marutham/tokens tokens:literals",
    "tokens:audit": "pnpm --filter @marutham/tokens tokens:audit",
    "ui:classes": "pnpm --filter @marutham/ui check:classes"
  }
}
