{
  "compilerOptions": {
    // ES2022 matches what Vite 8 builds for by default (Baseline Widely Available
    // browsers) and the Capacitor webview. Vitest 2's types used to pull ES2022 in
    // implicitly, which is how `.at()` in tests type-checked against an ES2020 lib.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
