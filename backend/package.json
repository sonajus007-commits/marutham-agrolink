{
  "name": "marutham-agrolink-backend",
  "version": "1.0.0",
  "description": "Marutham Agrolink backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test 'test/**/*.test.js'",
    "db:check": "node db/check-schema.js",
    "db:coverage": "node db/check-schema.js --coverage",
    "db:offline": "node db/check-schema.js --offline",
    "db:snapshot": "node db/check-schema.js --write",
    "db:check-embeds": "node db/check-embeds.js",
    "db:check-reads": "node db/check-reads.js",
    "db:check-rls": "node db/check-rls.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:status": "node db/migrate.js --status",
    "db:adopt": "node db/migrate.js --adopt",
    "db:verify-rebuild": "node db/migrate.js --verify-rebuild"
  },
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pg": "^8.23.1"
  }
}
