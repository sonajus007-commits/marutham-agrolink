{
  "name": "marutham-agrolink-backend",
  "version": "1.0.0",
  "description": "Marutham Agrolink backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/",
    "db:check": "node db/check-schema.js",
    "db:coverage": "node db/check-schema.js --coverage",
    "db:offline": "node db/check-schema.js --offline",
    "db:snapshot": "node db/check-schema.js --write",
    "db:check-embeds": "node db/check-embeds.js",
    "db:check-reads": "node db/check-reads.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:status": "node db/migrate.js --status",
    "db:adopt": "node db/migrate.js --adopt",
    "db:verify-rebuild": "node db/migrate.js --verify-rebuild"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pg": "^8.22.0"
  }
}
