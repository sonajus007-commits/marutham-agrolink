SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
JWT_SECRET=change-this-to-a-long-random-secret
PORT=3000
NODE_ENV=production

# ── Direct Postgres connection — REQUIRED ONLY BY THE MIGRATION RUNNER ────────
# The server itself never uses this. `npm run db:migrate` (and db:status,
# db:adopt, db:verify-rebuild) do, because PostgREST — which is all the service
# key can speak — executes queries, not DDL. Nothing else in this repo can run a
# CREATE TABLE, which is why the first 25 migrations were pasted in by hand.
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# `[YOUR-PASSWORD]` in what Supabase shows you is LITERAL — substitute the real
# database password (same page; reset it there if it was never recorded — that
# does not affect the service key or any running app).
#
# Prefer the SESSION POOLER string if the page offers one: newer projects make
# db.<ref>.supabase.co IPv6-only, and a direct connect just hangs on an IPv4-only
# network. It must be port 5432 (session mode) — port 6543 is transaction mode
# and cannot run the transactions migrations depend on.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── App URL (used in email links) ────────────────────────────────────────────
APP_URL=https://your-domain.com

# ── Security: CORS + proxy trust ─────────────────────────────────────────────
# CORS_ORIGINS: comma-separated allowlist of browser origins permitted to call the
# API. Leave BLANK for same-origin deploys (frontend served by this server) — it
# then falls back to open. Set it the moment the frontend is on a different origin.
CORS_ORIGINS=
# TRUST_PROXY_HOPS: how many reverse proxies sit in front of this server. The rate
# limiter needs it to see the real client IP. 1 = one proxy (typical PaaS/nginx).
# Set too high and X-Forwarded-For becomes spoofable; too low and every client looks
# like the proxy. Default 1.
TRUST_PROXY_HOPS=1

# ── Shop proxy (optional) — the Next.js marketplace ──────────────────────────
# When set, / and /_next/* proxy to this URL. Unset → the static home.html is served
# as the outage floor. Leave blank if you are not running the separate shop app.
SHOP_URL=

# ── Daily mandi price sync (optional) ────────────────────────────────────────
# DATA_GOV_API_KEY: data.gov.in key for the 6 AM price sync. Blank → sync is skipped.
# PRICE_SYNC_STATE: which state's mandi prices to pull (default Tamil Nadu).
DATA_GOV_API_KEY=
PRICE_SYNC_STATE=Tamil Nadu

# ── Email (SMTP) — Gmail example: use App Password if 2FA enabled ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Marutham Agrolink <your-email@gmail.com>

# ── Admin notification email (receives new registration alerts) ───────────────
ADMIN_EMAIL=headoffice@marutham.in

# ── Support contact shown in rejection emails ─────────────────────────────────
SUPPORT_PHONE=+91 98765 43210

# ── Payment details sent to applicants in approval email ─────────────────────
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NO=1234567890
BANK_IFSC=BANK0001234
BANK_UPI_ID=marutham@upi

# ── SMS — MSG91 (optional; leave blank to log SMS to console) ─────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER=MARUTH
